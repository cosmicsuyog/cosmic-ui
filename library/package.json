{
  "name": "cosmic-ui-library",
  "version": "1.0.15",
  "description": "A lightweight React UI component library with cards, forms, navigation, dashboards, AI UI blocks, and utility components.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils/browser": {
      "import": "./dist/utils/browser/index.mjs",
      "require": "./dist/utils/browser/index.js"
    },
    "./utils/browser/clipboard": {
      "import": "./dist/utils/browser/clipboard.mjs",
      "require": "./dist/utils/browser/clipboard.js"
    },
    "./utils/browser/storage": {
      "import": "./dist/utils/browser/storage.mjs",
      "require": "./dist/utils/browser/storage.js"
    },
    "./utils/performance": {
      "import": "./dist/utils/performance/index.mjs",
      "require": "./dist/utils/performance/index.js"
    },
    "./utils/performance/debounce": {
      "import": "./dist/utils/performance/debounce.mjs",
      "require": "./dist/utils/performance/debounce.js"
    },
    "./utils/performance/throttle": {
      "import": "./dist/utils/performance/throttle.mjs",
      "require": "./dist/utils/performance/throttle.js"
    },
    "./utils/general": {
      "import": "./dist/utils/general/index.mjs",
      "require": "./dist/utils/general/index.js"
    },
    "./utils/general/otp": {
      "import": "./dist/utils/general/otp.mjs",
      "require": "./dist/utils/general/otp.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/assets"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "author": "Suyog",
  "license": "ISC",
  "keywords": [
    "react",
    "ui",
    "components",
    "cosmic-ui",
    "component-library"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
